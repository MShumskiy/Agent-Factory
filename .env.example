# LLMP OpenAI-compatible API (the /v1 base URL) and an LLMP key
LLMP_BASE_URL=http://localhost:8000/v1
LLMP_API_KEY=

# Default models when a scenario doesn't name them (LLMP ids: <provider>/<model>)
JANUS_MODEL=ollama/gemma3:4b
JANUS_GM_MODEL=ollama/gpt-oss:20b
JANUS_JUDGE_MODEL=ollama/gpt-oss:20b
